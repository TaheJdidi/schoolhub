<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="EFCore.NamingConventions" Version="10.0.1" />
    <PackageReference Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="10.0.14" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.4">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
  </ItemGroup>

  <!-- Les pages Angular, construites dans frontend/ et rangées dans le wwwroot publié. -->
  <PropertyGroup>
    <DossierDuFrontend>$([MSBuild]::NormalizeDirectory('$(MSBuildProjectDirectory)', '..', '..', '..', 'frontend'))</DossierDuFrontend>
  </PropertyGroup>

  <!-- À la publication seulement : dotnet build et dotnet test n'ont pas besoin de Node.
       npm ci ne se lance que sur un dépôt neuf (le pipeline) : il commence par supprimer node_modules,
       ce qui échouerait sur le poste pendant que npm start tourne. -->
  <Target Name="ConstruireAngular" AfterTargets="ComputeFilesToPublish">
    <Exec WorkingDirectory="$(DossierDuFrontend)" Command="npm ci" Condition="!Exists('$(DossierDuFrontend)node_modules')" />
    <Exec WorkingDirectory="$(DossierDuFrontend)" Command="npm run build" />
    <ItemGroup>
      <FichiersAngular Include="$(DossierDuFrontend)dist\browser\**" />
      <ResolvedFileToPublish Include="@(FichiersAngular->'%(FullPath)')" Exclude="@(ResolvedFileToPublish)">
        <RelativePath>wwwroot\%(RecursiveDir)%(FileName)%(Extension)</RelativePath>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
        <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
      </ResolvedFileToPublish>
    </ItemGroup>
  </Target>

</Project>
